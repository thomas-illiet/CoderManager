# COMMUN
# api, migrate, worker
# Encode database credentials for use in a URL (for example, *%? becomes %2A%25%3F).
CODER_MANAGER_DATABASE_URL=postgresql+asyncpg://coder_manager:coder_manager@localhost:5432/coder_manager
CODER_MANAGER_DATABASE_SCHEMA=public
# api, beat, flower, worker
CODER_MANAGER_CELERY_BROKER_URL=redis://localhost:6379/0
# api, beat, worker
CODER_MANAGER_METRICS_HOST=0.0.0.0
CODER_MANAGER_METRICS_PORT=9808
# api, worker
CODER_MANAGER_CRYPTO_KEY=replace-with-base64-encoded-32-byte-key
CODER_MANAGER_ENVIRONMENT=development
CODER_MANAGER_INSTANCE_BASE_DOMAIN=emea.code-studio.echonet
CODER_MANAGER_ARGOCD_URL=https://argocd.example.com
CODER_MANAGER_ARGOCD_TOKEN=replace-with-service-account-token
CODER_MANAGER_ARGOCD_SKIP_SSL_VERIFY=false
CODER_MANAGER_ARGOCD_PROJECT_NAME=coder
CODER_MANAGER_ARGOCD_APPLICATION_PREFIX=coder
CODER_MANAGER_DEFAULT_ADMINS=admin1,admin2

# API
CODER_MANAGER_APP_NAME=Coder Manager
CODER_MANAGER_ALLOW_UNAUTHENTICATED_API=false
CODER_MANAGER_OIDC_ISSUER_URL=
CODER_MANAGER_OIDC_CLIENT_ID=
CODER_MANAGER_OIDC_AUTHORIZATION_URL=
CODER_MANAGER_OIDC_TOKEN_URL=
CODER_MANAGER_OIDC_SCOPES=openid,profile

# WORKER
PROMETHEUS_MULTIPROC_DIR=/tmp/coder-manager-prometheus
# Reserved for coder_manager.healthcheck; business tasks use PostgreSQL job state instead.
CODER_MANAGER_CELERY_RESULT_BACKEND=redis://localhost:6379/1
CODER_MANAGER_JOB_STALE_AFTER_SECONDS=300
CODER_MANAGER_TEMPLATE_SYNC_POLL_INTERVAL_SECONDS=2
CODER_MANAGER_TEMPLATE_SYNC_TIMEOUT_SECONDS=1800
CODER_MANAGER_WORKSPACE_BUILD_POLL_INTERVAL_SECONDS=2
CODER_MANAGER_WORKSPACE_BUILD_TIMEOUT_SECONDS=1800
CODER_MANAGER_WORKSPACE_STOP_POLL_INTERVAL_SECONDS=2
CODER_MANAGER_WORKSPACE_STOP_TIMEOUT_SECONDS=1800
CODER_MANAGER_WORKSPACE_DELETE_POLL_INTERVAL_SECONDS=2
CODER_MANAGER_WORKSPACE_DELETE_TIMEOUT_SECONDS=1800
CODER_MANAGER_ARGOCD_REPOSITORY_URL=https://git.example.com/platform/coder.git
CODER_MANAGER_ARGOCD_REPOSITORY_PATH=charts/coder
CODER_MANAGER_ARGOCD_TARGET_REVISION=main
CODER_MANAGER_ARGOCD_REGION=EMEA
CODER_MANAGER_ARGOCD_DESTINATION_NAME=coder-cluster
CODER_MANAGER_CYBERARK_APP_ID=coder-app
CODER_MANAGER_CYBERARK_CERT_NAME=coder-cert
CODER_MANAGER_CYBERARK_KEY_NAME=coder-key
CODER_MANAGER_CYBERARK_SAFE=coder-safe

# BEAT
CODER_MANAGER_SCHEDULER_TIMEZONE=Europe/Paris
CODER_MANAGER_JOB_RETRY_INTERVAL_SECONDS=60

# MIGRATE
# Utilise CODER_MANAGER_DATABASE_URL et CODER_MANAGER_DATABASE_SCHEMA definis dans COMMUN.

# FLOWER
# Utilise aussi CODER_MANAGER_CELERY_BROKER_URL defini dans COMMUN.
FLOWER_UNAUTHENTICATED_API=true
